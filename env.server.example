# Example environment values for running opendub-desktop_02.
#
# Copy relevant lines into your own shell/.env before starting the app. Paths
# below are safe generic defaults (already what the code falls back to) --
# override them only if your heavy-dep venvs / model files live somewhere else.
# NEVER put API keys or other secrets in this file (see .gitignore: *.env, .env).

# --- Interpreters for subprocess workers (need onnxruntime/torch/faster-whisper,
#     which the app's own Python 3.8 venv intentionally does not have) ---
QWEN_SCORER_PYTHON=python3
SEP_PYTHON=python3
STT_PYTHON=python3
DIAR_PYTHON=python3

# --- Local model directories (relative to the process working directory) ---
SEP_MODEL_DIR=models/demucs
WHISPER_MODEL_DIR=models/whisper/faster-whisper-large-v3
PERSODUB_CAMPPLUS_MODEL=models/campplus/campplus.onnx

# --- Take-scorer per-take ASR timeout, seconds (app/scripts/qwen_score_takes.py,
#     app/qwen_scoring.py) -- raise this on a slower machine ---
PERSODUB_SCORER_ASR_TIMEOUT=15
# --- Qwen3-TTS /generate request timeout, seconds (app/engines/qwen_tts.py) ---
PERSODUB_TTS_TIMEOUT=300
# --- CAM++ diarization subprocess timeout, seconds (app/diar_campplus_client.py) ---
PERSODUB_DIAR_TIMEOUT=600
# --- CAM++ auto-diarization: collapse back to one speaker when every pairwise
#     cluster-centroid similarity is >= this (app/scripts/campplus_diarize.py) ---
PERSODUB_DIAR_MERGE_SIM=0.38

# --- Leakage-gate staged rollout (app/pipeline.py, stage 5/6): "on" (default)
#     = measure + auto-fix; "measure" = log only, never rewrite the mix;
#     "off" = skip the stage entirely ---
PERSODUB_LEAKAGE_GATE=on

# --- Original-vocals gate mode: "safe" (default) never mixes the original
#     vocals into the output at all (leakage structurally impossible); "preserve"
#     (opt-in) keeps laughter/breaths between lines but hard-mutes detected
#     speech (app/qwen_pipeline.py, app/qwen_assemble.py) ---
QWEN_GATE_MODE=safe
# --- Original-vocals gating margin (app/qwen_assemble.py), seconds each side ---
QWEN_GATE_PAD_SEC=0.25
# --- Gate ducking level in dB, instead of hard-muting to true silence (app/qwen_assemble.py) ---
QWEN_GATE_DUCK_DB=18
# --- Energy-VAD gate extension: 1 = also gate speech DETECTED on the vocals stem
#     (catches dialogue STT missed -- see app/qwen_assemble.detect_speech_regions) ---
QWEN_GATE_VAD=1
# --- Two-tier duck: VAD-detected speech is ducked this deep (near-silent);
#     non-speech gated spans keep the gentler QWEN_GATE_DUCK_DB ambience duck ---
QWEN_GATE_SPEECH_DUCK_DB=40
# --- A/B escape hatch: 1 = detected-speech-only regions do NOT extend the gate ---
QWEN_GATE_KEEP_NONSPEECH=0
# --- Laughter whitelist on top of safe mode (app/nonverbal.py): 1 = copy
#     whisper-verified non-speech vocal segments (laughter/breaths/sighs) back
#     into the mix at ORIGINAL volume; 0 = plain safe mode, nothing copied ---
QWEN_KEEP_NONVERBAL=1
# --- Interpreter with openai-whisper installed, for the whitelist's veto
#     subprocess (CPU is fine -- it only transcribes sub-second clips) ---
NONVERBAL_WHISPER_PYTHON=python3
NONVERBAL_WHISPER_MODEL=base
# --- 1 = duck the background stem too where a detected-speech region's bed content
#     is mostly Demucs vocal bleed (original dialogue leaking via the bed) ---
QWEN_GATE_BED_RESIDUE=1
# --- Cap, in seconds, on how much lead silence is trimmed off a line before placement (app/qwen_assemble.py) ---
QWEN_TRIM_LEAD_SEC=1.0
# --- Cap on the gain ratio allowed between two adjacent lines (app/qwen_assemble.py) ---
QWEN_GAIN_STEP_MAX=1.5

# --- Qwen3-TTS voice-clone mode: "timbre" (speaker-embedding only, no reference
#     transcript needed -- default) | "icl" (in-context-learning, needs one) ---
QWEN_VOICE_MODE=timbre

# --- Perso STT (optional; local Whisper is used when unset) ---
# PERSO_API_KEY=            # secret -- put in a real .env, not here
# PERSO_SPACE_SEQ=          # required if using Perso: your account's space id
# PERSO_MEDIA_HOST=         # required if using Perso: your account's media host

# --- Translation ---
# GEMINI_API_KEY=           # secret -- put in a real .env, not here

# --- Ollama model tags now default to stock names (gemma3:12b / qwen2.5:7b) so a
#     plain `ollama pull` works out of the box. A server using custom aliases
#     instead (e.g. gemma-dub, qwen-dub) must set these to match: ---
# OLLAMA_GEMMA_MODEL=gemma-dub
# OLLAMA_QWEN_MODEL=qwen-dub

# --- Vertex AI Gemini translation (TRANSLATE_ENGINE=vertex; paid, service-account, no
#     free-tier 429s). VERTEX_SA_KEY_PATH must point at a real key file -- never commit it. ---
# VERTEX_SA_KEY_PATH=config/vertex-service-account.json
# VERTEX_LOCATION=us-central1
# VERTEX_MODEL=gemini-2.5-flash
