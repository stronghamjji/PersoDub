{
  // The relay that turns a failure report into a GitHub issue. Deployed by
  // hand from this folder (`wrangler deploy`), not by CI: it holds a token,
  // and nothing in the release pipeline should be able to reach it.
  //
  // GITHUB_TOKEN and LOG_SIGNING_KEY are secrets -- `wrangler secret put`,
  // never this file. GITHUB_REPO is the public repository: the relay signs in
  // as a bot account whose token carries the public_repo scope, and a private
  // repository is not reachable with that scope (2026-09-10).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "persodub-report",
  "main": "report-worker.js",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "kv_namespaces": [
    { "binding": "REPORTS", "id": "31c7975c8c98486ba89345d9495c8f48" }
  ],
  // Uploaded logs live here for 30 days, then the bucket's expire-30d rule
  // deletes them. Without this binding the Worker answers 501 to a log upload
  // and the issue is created without the "Full logs" line (2026-09-16).
  "r2_buckets": [{ "binding": "LOGS", "bucket_name": "persodub-report-logs" }],
  "vars": {
    "GITHUB_REPO": "stronghamjji/PersoDub",
    "MAX_PER_DAY": "5",
    "MAX_TOTAL_PER_DAY": "200",
    // Finished jobs' records (POST /record), counted apart from the reports.
    "MAX_RECORDS_PER_DAY": "50",
    "MAX_RECORDS_TOTAL_PER_DAY": "500"
    // POST /events reads GA4_MEASUREMENT_ID, GA4_API_SECRET, AMPLITUDE_API_KEY,
    // EXCLUDED_DEVICES and EVENTS_USER_KEY (the key the account's id is hashed
    // with; without it no user id is sent) as secrets; "GA4_DEBUG": "1" here
    // while checking DebugView (relay/README.md).
  }
}
